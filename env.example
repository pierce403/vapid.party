# VAPID Configuration
VAPID_SUBJECT=mailto:admin@vapid.party

# Converge XMTP relay configuration for Cloudflare Worker secrets and vars.
# CONVERGE_APP_ID defaults to "converge" in wrangler.jsonc.
# Provision the reserved app row in D1, then set both VAPID keys and both
# listener tokens as Wrangler secrets. The two listener tokens must be
# independent.
CONVERGE_APP_ID=converge
CONVERGE_VAPID_PUBLIC_KEY=
CONVERGE_VAPID_PRIVATE_KEY=
INTERNAL_INGEST_TOKEN=
XMTP_LISTENER_SYNC_TOKEN=

# Optional: enables the reserved app's generic X-API-Key routes. Those routes
# fail closed when this is absent. Environment-driven creation of a missing
# reserved app row also requires this value; operator D1 provisioning does not.
CONVERGE_API_KEY=
