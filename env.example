# Thirdweb Configuration (legacy dashboard/admin UI)
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your_thirdweb_client_id_here

# Legacy Postgres configuration for the old Next/Vercel runtime.
# The Cloudflare Worker runtime uses D1 bindings from wrangler.jsonc.
POSTGRES_URL=postgres://user:password@host:5432/database?sslmode=require

# VAPID Configuration
VAPID_SUBJECT=mailto:admin@vapid.party

# Converge XMTP relay configuration for Cloudflare Worker secrets/vars.
# CONVERGE_APP_ID defaults to "converge" in wrangler.jsonc.
# If that app row has not been created in D1, set these as Wrangler secrets
# so the Worker can bootstrap the Converge app metadata.
CONVERGE_APP_ID=converge
CONVERGE_VAPID_PUBLIC_KEY=base64url_public_vapid_key
CONVERGE_VAPID_PRIVATE_KEY=base64url_private_vapid_key
INTERNAL_INGEST_TOKEN=replace_with_random_secret

# Logging (optional)
LOG_LEVEL=info
