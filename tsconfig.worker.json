{
  "compilerOptions": {
    "allowJs": false,
    "esModuleInterop": true,
    "incremental": false,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": [
    "src/worker/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
