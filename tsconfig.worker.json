{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "incremental": false,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": [
    "src/worker/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "app",
    "components",
    "hooks",
    "lib",
    "scripts"
  ]
}
