{
  "name": "vapid-party",
  "version": "1.0.0",
  "description": "Cloudflare Web Push and XMTP-aware relay",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist/worker",
    "start": "wrangler dev --remote",
    "lint": "tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply vapid-party --local",
    "db:migrate:remote": "wrangler d1 migrations apply vapid-party --remote"
  },
  "keywords": [
    "vapid",
    "web-push",
    "notifications",
    "push-api",
    "web3",
    "xmtp",
    "cloudflare"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260714.1",
    "@types/node": "^22.0.0",
    "@types/web-push": "^3.6.3",
    "miniflare": "4.20260708.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7",
    "wrangler": "4.110.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
