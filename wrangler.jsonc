{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vapid-party",
  "main": "src/worker/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "vars": {
    "VAPID_SUBJECT": "mailto:admin@vapid.party",
    "CONVERGE_APP_ID": "converge",
    "VAPID_PARTY_PUBLIC_URL": "https://vapid.party"
  },
  "containers": [
    {
      "class_name": "XmtpListenerContainer",
      "image": "./infra/xmtp-listener/Dockerfile",
      "max_instances": 1,
      "instance_type": "lite",
      "rollout_step_percentage": 100
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vapid-party",
      "database_id": "c78e2c36-5768-43e1-936e-79b5850871bb",
      "migrations_dir": "migrations/d1"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PUSH_QUEUE",
        "queue": "vapid-party-push-send"
      }
    ],
    "consumers": [
      {
        "queue": "vapid-party-push-send",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 30,
        "dead_letter_queue": "vapid-party-push-dlq"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_COORDINATOR",
        "class_name": "RelayCoordinator"
      },
      {
        "name": "XMTP_LISTENER",
        "class_name": "XmtpListenerContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayCoordinator"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["XmtpListenerContainer"]
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "routes": [
    {
      "pattern": "vapid.party",
      "custom_domain": true
    }
  ]
}
